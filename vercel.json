{
  "version": 2,
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://runagen-backend.onrender.com/api/$1" },
    { "source": "/health", "destination": "https://runagen-backend.onrender.com/health" },
    { "source": "/live-dashboard.html", "destination": "/web/live-dashboard.html" },
    { "source": "/live-dashboard.css", "destination": "/web/live-dashboard.css" },
    { "source": "/live-dashboard.js", "destination": "/web/live-dashboard.js" },
    { "source": "/script.js", "destination": "/web/script.js" },
    { "source": "/styles.css", "destination": "/web/styles.css" },
    { "source": "/index.html", "destination": "/web/index.html" },
    { "source": "/", "destination": "/web/index.html" }
  ]
}
